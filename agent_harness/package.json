{
  "name": "visual-behavior-agent-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:integration": "RUN_PLAYWRIGHT_INTEGRATION=1 vitest run tests/integration",
    "test:live": "RUN_GEMINI_SMOKE=1 vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "2.17.1",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
